{
  "expo": {
    "name": "grail",
    "slug": "grail",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#16130f",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.grailnotebook.app",
      "versionCode": 10100,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16130f"
      },
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.grailnotebook.app",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16130f"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "grail adds the pictures you choose to your notes.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/release-signing",
      "./plugins/short-native-paths",
      "./plugins/no-dependencies-info"
    ]
  }
}
